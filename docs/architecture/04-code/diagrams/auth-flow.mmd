sequenceDiagram
    autonumber
    
    Note over User,Auth0: Frontend User Authentication (Auth0)
    
    participant User
    participant Frontend as Frontend<br/>(Svelte)
    participant AuthService as Auth Service<br/>(authService.ts)
    participant Auth0 as Auth0<br/>(HTWK SSO)
    
    User->>Frontend: Navigate to app
    activate Frontend
    Frontend->>AuthService: initAuth()
    activate AuthService
    
    AuthService->>AuthService: Fetch /auth_config.json
    AuthService->>AuthService: createAuth0Client()
    AuthService->>AuthService: Check isAuthenticated()
    
    alt Not Authenticated
        AuthService-->>Frontend: isAuthenticated = false
        Frontend-->>User: Show login screen
        
        User->>Frontend: Click "Login"
        Frontend->>AuthService: login()
        AuthService->>Auth0: loginWithRedirect()
        Auth0-->>User: Redirect to Auth0 login page
        
        User->>Auth0: Enter HTWK credentials
        Auth0->>Auth0: Validate with HTWK SSO
        Auth0-->>User: Redirect to app<br/>?code=abc&state=xyz
        
        User->>Frontend: Callback with code
        Frontend->>AuthService: handleRedirectCallback()
        AuthService->>Auth0: Exchange code for tokens
        Auth0-->>AuthService: Access token, ID token
        AuthService->>AuthService: Store in localStorage
        AuthService->>Auth0: getUser()
        Auth0-->>AuthService: User profile
        AuthService-->>Frontend: Update auth state
        Frontend-->>User: Show main app
    else Already Authenticated
        AuthService->>AuthService: Retrieve from cache
        AuthService-->>Frontend: isAuthenticated = true<br/>user = {...}
        Frontend-->>User: Show main app
    end
    
    deactivate AuthService
    deactivate Frontend
    
    Note over MCP,TokenDB: <br/><br/>Internal Service Authentication (MCP ↔ Autotester)
    
    participant MCP as MCP Service<br/>(API Repository)
    participant Nginx as Nginx<br/>(Reverse Proxy)
    participant Router as Autotester<br/>(Router)
    participant Middleware as Internal Middleware<br/>(CIDR Check)
    participant AuthSvc as Auth Service<br/>(GenerateToken)
    participant TokenDB as Token Database<br/>(PostgreSQL)
    
    MCP->>MCP: Service starts<br/>Need auth token
    MCP->>Nginx: POST /api/v1/auth/generate<br/>{userId: "mcp-service"}
    activate Nginx
    
    Nginx->>Nginx: Check source IP<br/>Allow: 172.16.0.0/12,<br/>192.168.0.0/16
    
    alt External IP
        Nginx-->>MCP: 403 Forbidden
    else Internal IP (Docker network)
        Nginx->>Router: Forward request
        activate Router
        
        Router->>Middleware: internalOnlyMiddleware()
        activate Middleware
        
        Middleware->>Middleware: Extract client IP
        Middleware->>Middleware: Validate against CIDRs
        
        alt IP not in allowed ranges
            Middleware-->>Router: Abort with 403
            Router-->>Nginx: 403 Forbidden
            Nginx-->>MCP: 403 Forbidden
        else IP in allowed ranges
            Middleware->>Router: Continue
            deactivate Middleware
            
            Router->>AuthSvc: HandleGenerateToken()
            activate AuthSvc
            
            AuthSvc->>AuthSvc: Create JWT claims<br/>{sub, iat, exp, iss}
            AuthSvc->>AuthSvc: Sign with secret key
            
            AuthSvc->>TokenDB: INSERT token<br/>(user_id, token, expires_at)
            activate TokenDB
            TokenDB-->>AuthSvc: OK
            deactivate TokenDB
            
            AuthSvc-->>Router: {token, expiresAt}
            deactivate AuthSvc
            
            Router-->>Nginx: 200 OK<br/>{token: "eyJ..."}
            deactivate Router
            
            Nginx-->>MCP: 200 OK<br/>{token: "eyJ..."}
            deactivate Nginx
            
            MCP->>MCP: Store token in memory
        end
    end
    
    Note over MCP,Router: <br/>API Request with Token
    
    MCP->>MCP: Tool invoked<br/>Need to call Autotester
    MCP->>Router: POST /api/v1/chat<br/>Authorization: Bearer eyJ...
    activate Router
    
    Router->>Router: Extract token
    Router->>Router: Validate JWT<br/>- Signature<br/>- Expiry<br/>- Issuer
    
    alt Token invalid or expired
        Router-->>MCP: 401 Unauthorized
        MCP->>MCP: Refresh token<br/>(repeat generation flow)
    else Token valid
        Router->>Router: Process request normally
        Router-->>MCP: 200 OK with response
    end
    
    deactivate Router
