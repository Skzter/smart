@go.Package { name = "gitlab.dit.htwk-leipzig.de/projekt2025-w-llm-unterstuetztes-autotesting-fuer-moderne-web-frontends/smart/internal/mcp/domain/config" }
module mcp

import "package://pkg.pkl-lang.org/pkl-go/pkl.golang@0.10.0#/go.pkl" 

logLevel: String = "debug"
port: String = ":8084"

/// Server implementation details
class McpServerImplementation {

  name: String = "autotester-mcp"
  
  version: String = "1.0.0"
}

mcpServerImplementation : McpServerImplementation

/// HTTP Client configuration
class HttpClientConfig {
  timeoutSeconds: Int = 600
  
  maxIdleConns: Int = 100
  
  maxIdleConnsPerHost: Int = 10
  
  idleConnTimeoutSeconds: Int = 300
}

httpClient: HttpClientConfig 

autotesterAPIBaseURL: String = "http://localhost:8081" // zum testen für live ändern
