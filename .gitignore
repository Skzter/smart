# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
suproxy
autotester
!suproxy/
!autotester/
!task.exe
!doppler.exe
!pkl.exe

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov
.gitlab-ci-local
.task/
*.xml

# Go workspace file
go.work
go.work.sum

# env file
.env

# temp files
tmp/

# logs
*.log

#generated Code
*.pkl.go
*.msgpack
*_gen.go

# Editor/IDE
.idea/
.vscode/
.DS_Store

# Test output for autotester
fixtures/autotester/out/output.txt

# k6 
test/k6/suproxy/k6-summary.json
test/k6/suproxy/k6-summary-ramp.json
test/k6/autotester/k6-summary.json
scripts/k6/.venv/
scripts/k6/k6_plotting.egg-info/
*.png
