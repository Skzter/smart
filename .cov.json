{
  "OutputFormat": "cobertura",
  "Complexity": {
    "Active": true,
    "Type": "cognitive"
  },
  "SourcePath": "./",
  "ExcludePaths": [
    "vendor",
    ".go"
  ],
  "Cleaner": {
    "ErrorIf": true,
    "NoneCodeLines": true,
    "Generated": true,
    "CustomIf": [
      "debug"
    ]
  }
}
