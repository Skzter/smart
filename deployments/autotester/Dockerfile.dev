FROM golang:latest AS builder

WORKDIR /app

COPY go.mod ./
COPY go.sum ./

RUN go mod download

# Copy only necessary files and directories for the autotester build
COPY cmd/autotester/ ./cmd/autotester/
COPY internal/ ./internal/
COPY configs/ ./configs/
COPY web/embed.go ./web/
COPY web/auth_config.json ./web/
COPY web/dist/ ./web/dist/

RUN go tool golangci-lint run

RUN go test ./...

# CGO_ENABLED=0 ensures static linking for scratch container
# -ldflags="-s -w" reduces binary size by stripping debug information
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o bin/autotester ./cmd/autotester

FROM scratch

COPY --from=builder /app/bin/autotester /bin/autotester

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

ENTRYPOINT ["/bin/autotester"]
